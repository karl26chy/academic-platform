# Server — Desarrollo local (aislado de Supabase)
# Desde el host usa 55432 (alineado con TEST_DATABASE_URL y docker-compose.local.yml);
# dentro de Docker el host es `db:5432`.
PORT=5000
DATABASE_URL=postgresql://platform:platform@localhost:55432/platform?sslmode=disable
# Alternativa Docker interno: postgres://platform:platform@db:5432/platform?sslmode=disable
# NUNCA pongas aquí una URL con supabase.co / pooler.supabase.com en desarrollo.
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma.
# Vacío = cualquier origen (desarrollo local).
# Producción: CORS_ORIGIN=https://frontend.onrender.com
CORS_ORIGIN=

# El pool de PostgreSQL habilita SSL automáticamente para hosts remotos
# (Supabase, Render, etc.). En localhost no usa SSL.
