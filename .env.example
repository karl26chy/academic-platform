# Credenciales de PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

# Secreto para firmar los JWT. OBLIGATORIO: la API no arranca sin uno real
# (al menos 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración del token
JWT_EXPIRES_IN=8h

# Puerto público del frontend en el host
CLIENT_PORT=8080

# Dominio(s) del frontend solo si se sirve desde OTRO origen (separados por coma).
# Vacío = solo mismo origen (lo normal: nginx sirve el frontend y /api juntos).
CORS_ORIGIN=

# Cuántos proxies hay delante del API, para leer la IP real del cliente.
# 1 = solo el nginx del cliente. Súmale uno por cada proxy extra
# (por ejemplo un nginx en el host o Cloudflare).
TRUST_PROXY=1
