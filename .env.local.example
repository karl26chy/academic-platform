# Plantilla de .env.local — NO contiene secretos reales
# Copia a .env.local y ajusta si necesitas:
#   cp .env.local.example .env.local

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
PG_LOCAL_PORT=55432

# Local PG (host):  localhost:55432
DATABASE_URL=postgresql://platform:platform@localhost:55432/platform?sslmode=disable
# Dentro de Docker: postgres://platform:platform@db:5432/platform?sslmode=disable

PORT=5000
JWT_SECRET=local-dev-secret-change-me-no-usar-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=

VITE_API_PROXY_TARGET=http://localhost:5000
CLIENT_PORT=8080
API_PORT=5000
